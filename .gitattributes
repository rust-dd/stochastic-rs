# Linguist: the Python and notebooks are binding glue and harnesses, so they stay off the language
# bar; `linguist-detectable=false`, not `linguist-vendored`, which would collapse their diffs too.
*.py linguist-detectable=false
*.ipynb linguist-detectable=false
docs/* linguist-documentation
# Generated by the stochastic crate's build script; regenerate instead of reviewing diffs.
stochastic-rs-stochastic/metal/** linguist-generated -diff
